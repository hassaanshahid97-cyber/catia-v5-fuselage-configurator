# =============================================================
# TMKT57 - Product Modelling
# Fuselage & Landing Gear Configurator
# .gitignore  (Visual Studio + CATIA V5 + OS)
# =============================================================

# -------- Visual Studio build artefacts --------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/

# VS working directory (contains project.assets.json, cached IntelliSense, etc.)
.vs/

# VS user-specific files (do not share between machines)
*.user
*.userprefs
*.suo
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb

# Build results
*.pdb
*.dll
*.exe
*.cache
*.ilk
*.meta
*.obj
*.iobj
*.ipdb
*.res
*.tlog
*.lastbuildstate

# NuGet
packages/
*.nupkg
!**/packages/build/
!**/packages/*/build/

# ReSharper / Rider (in case someone opens it)
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Published web
[Pp]ublish/
*.[Pp]ublish.xml
*.azurePubxml

# =============================================================
# CATIA V5 — keep only source parts, ignore everything volatile
# =============================================================

# CATIA backup files (auto-created on every save, noisy in diffs)
*.CATPart~
*.CATProduct~
*.CATDrawing~
*.CATAnalysis~
*.CATShape~
*.CATMaterial~
*.bak

# CATIA autosave / lock / log files
*.CATPart.lck
*.CATProduct.lck
*.CATlog
*.stlog
CNext.trace
cnext.trace
JournalFiles/
CATIATemp/
AutoSave/

# CATIA cache / temporary working files
*.tmp
*.CATProcess
*.CATScript.tmp

# IMPORTANT — DO commit these (they are the project):
# *.CATPart
# *.CATProduct
# *.CATDrawing
# *.CATScript

# =============================================================
# SQLite database — commit schema but NOT user data
# =============================================================
# Commit a seed DB with the standard configurations, ignore local data copies
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db-journal
# If you prefer to keep the DB out entirely, uncomment:
# *.sqlite
# *.db

# =============================================================
# OS / editor junk
# =============================================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
*.swp
*.swo
*~

# Office lock files (~$filename.docx)
~$*

# =============================================================
# Project-specific: generated instance files from VS.NET runs
# Instantiation runs create scratch CATParts which should NOT be
# committed (they can be regenerated by running the configurator).
# =============================================================
CATIA/Instances/*
!CATIA/Instances/.gitkeep
